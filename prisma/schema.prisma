generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoleType {
  SUPER_ADMIN
  MANAGER
  MEMBER
}

enum ExpenseCategory {
  MEAL_BAZAR
  HOUSE_RENT
  UTILITIES
  INTERNET
  MAID_BILL
  OTHER
}

enum TransactionType {
  DEPOSIT
  DEDUCTION
  ADJUSTMENT
}

enum PayoutCategory {
  GAS_BILL
  ELECTRICITY
  WIFI_BILL
  HOME_RENT
  MAID_BILL
  MEMBER_REFUND
  OTHER
}

enum ExpenseUnit {
  KG
  LITRE
  PIECE
  PACKET
  GRAM
  DOZEN
}

enum BazarCategory {
  MEAT
  FISH
  VEGETABLES
  FRUITS
  DAIRY
  GROCERY
  SPICES
  BEVERAGES
  SNACKS
  OTHER
}

enum DayOfWeek {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

// --- MODELS ---

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  phone          String?      @unique
  passwordHash   String
  firstName      String
  lastName       String
  profilePicture String?
  currentBalance Decimal      @default(0) @db.Decimal(12, 2)
  isActive       Boolean      @default(true)
  isSuperAdmin   Boolean      @default(false)
  tokenVersion   Int          @default(0)
  managedHouse   House?       @relation("HouseManager")
  membership     HouseMember?

  paidExpenses    Expense[]      @relation("Payer")
  createdExpenses Expense[]      @relation("ExpenseCreator")
  mealLogs        MealLog[]      @relation("MealUser")
  deposits        Deposit[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  transactions    Transaction[]
  mealSheetLocks  MealSheetLock[] @relation("MealSheetLocker")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model House {
  id                 String  @id @default(cuid())
  name               String
  address            String?
  inviteCode         String  @unique @default(cuid())
  isMealSystemActive Boolean @default(true)
  currentMealRate    Decimal @default(0) @db.Decimal(10, 4)
  managerId          String  @unique
  manager            User    @relation("HouseManager", fields: [managerId], references: [id])

  members      HouseMember[]
  expenses     Expense[]
  mealLogs     MealLog[]
  deposits     Deposit[]
  auditLogs    AuditLog[]
  transactions Transaction[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdById    String?
  updatedById    String?
  userFixedCosts UserFixedCost[]
  mealSheetLocks MealSheetLock[]
  weeklyMenu     WeeklyMenu[]

  @@map("houses")
}

model MealSheetLock {
  id         String   @id @default(cuid())
  houseId    String
  month      String   // "YYYY-MM"
  lockedById String
  lockedAt   DateTime @default(now())

  house    House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  lockedBy User  @relation("MealSheetLocker", fields: [lockedById], references: [id])

  @@unique([houseId, month])
  @@map("meal_sheet_locks")
}

model HouseMember {
  id      String @id @default(cuid())
  houseId String
  userId  String @unique

  role     RoleType  @default(MEMBER)
  isActive Boolean   @default(true)
  joinDate DateTime  @default(now())
  leftDate DateTime?

  totalMeals   Decimal @default(0) @db.Decimal(10, 1)
  totalDeposit Decimal @default(0) @db.Decimal(10, 2)
  totalCost    Decimal @default(0) @db.Decimal(10, 2)

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdById   String?
  updatedById   String?
  userFixedCost UserFixedCost?

  @@map("house_members")
}

model UserFixedCost {
  id       String @id @default(cuid())
  memberId String @unique
  houseId  String

  roomRent       Decimal @default(0) @db.Decimal(12, 2)
  khalaBill      Decimal @default(0) @db.Decimal(12, 2)
  wifiBill       Decimal @default(0) @db.Decimal(12, 2)
  electricity    Decimal @default(0) @db.Decimal(12, 2)
  gasBill        Decimal @default(0) @db.Decimal(12, 2)
  waterBill      Decimal @default(0) @db.Decimal(12, 2)
  otherBill      Decimal @default(0) @db.Decimal(12, 2)
  totalFixedCost Decimal @default(0) @db.Decimal(12, 2)

  lastUpdated DateTime @updatedAt
  updatedById String?

  member HouseMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  house  House       @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@map("user_fixed_costs")
}

model Expense {
  id          String          @id @default(cuid())
  title       String
  amount      Decimal         @db.Decimal(12, 2)
  category    ExpenseCategory @default(MEAL_BAZAR)
  expenseDate DateTime        @default(now())
  quantity    Decimal?        @db.Decimal(10, 2)
  unit        ExpenseUnit?    @default(KG)
  bazarCategory BazarCategory?

  isBazar     Boolean @default(true)
  isFixedCost Boolean @default(false)
  houseId     String
  payerId     String // Who paid the money
  house       House   @relation(fields: [houseId], references: [id], onDelete: Cascade)
  payer       User    @relation("Payer", fields: [payerId], references: [id])

  // Audit Fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String // Who entered the record
  creator     User     @relation("ExpenseCreator", fields: [createdById], references: [id])
  updatedById String?

  @@index([houseId, expenseDate])
  @@map("expenses")
}

model MealLog {
  id      String   @id @default(cuid())
  houseId String
  userId  String
  date    DateTime @db.Date

  lunch  Decimal @default(1.0) @db.Decimal(2, 1)
  dinner Decimal @default(1.0) @db.Decimal(2, 1)

  guestLunch  Int @default(0)
  guestDinner Int @default(0)

  totalDay Decimal @default(2.0) @db.Decimal(4, 1)

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  user  User  @relation("MealUser", fields: [userId], references: [id], onDelete: Cascade)

  // Audit Fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  updatedById String?

  @@unique([houseId, userId, date])
  @@map("meal_logs")
}

model Deposit {
  id      String   @id @default(cuid())
  houseId String
  userId  String
  title   String   @default("Deposit")
  amount  Decimal  @db.Decimal(12, 2)
  date    DateTime @default(now())

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Audit Fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  updatedById String?

  @@map("deposits")
}

model Transaction {
  id          String           @id @default(cuid())
  houseId     String
  userId      String
  amount      Decimal          @db.Decimal(12, 2)
  type        TransactionType
  category    PayoutCategory?
  month       String?          // "YYYY-MM" — which settlement month this belongs to
  description String?

  house House @relation(fields: [houseId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())
  createdById String?

  @@map("transactions")
}

model AuditLog {
  id        String   @id @default(cuid())
  houseId   String
  userId    String? // Action Performer
  action    String // e.g., CREATE, UPDATE, DELETE
  entity    String // e.g., Expense, MealLog
  entityId  String
  payload   Json? // Stores the data involved
  createdAt DateTime @default(now())

  house House @relation(fields: [houseId], references: [id])
  user  User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model WeeklyMenu {
  id          String    @id @default(cuid())
  houseId     String
  dayOfWeek   DayOfWeek
  lunch       String    @default("")
  dinner      String    @default("")
  updatedAt   DateTime  @updatedAt
  updatedById String?

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@unique([houseId, dayOfWeek])
  @@map("weekly_menu")
}
